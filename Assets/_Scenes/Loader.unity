--- !u!114 &4552
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1110}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ea61b83e71262a95c492935eb0f2d66, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  hints:
  - name: GIVE
    shortDesc: adds item to the inventory
    fullDesc: 'adds item to the inventory



      SYNTAX:

      GIVE <i>ITEMID</i>

      WHERE:

      ITEMID
      is the identification number of the item



      NOTE:

      Check "ITEMLIST"
      to display a list of item IDs.'
  - name: ITEMLIST
    shortDesc: displays a list of Item IDs
    fullDesc: 'displays a list of Item IDs



      SYNTAX:

      ITEMLIST <i>PAGENUMBER</i>

      WHERE:

      PAGENUMBER
      is an integer specifying the page number'
  - name: CLEAR
    shortDesc: clears the console screen
    fullDesc: 'clears the console screen



      SYNTAX:

      CLEAR



      NOTE:

      -You
      can use the "CLS" command as well'
  - name: QUIT
    shortDesc: terminates the game process
    fullDesc: 'terminates the game process



      SYNTAX:

      QUIT



      NOTE:

      -You
      can use the "EXIT" command as well'
  - name: REFRESHFIX
    shortDesc: changes the console refresh mode
    fullDesc: 'changes the console refresh mode



      SYNTAX:

      REFRESHFIX



      NOTE:

      There
      are two refreshing modes:

      -Optimized - Smart refreshing only when it''s
      necessary

      -Fixed - Refresh with every frame of the screen'
  - name: VALUE
    shortDesc: Displays the value of the variable giving its hidden code
    fullDesc: 'Displays the value of the variable giving its hidden code



      SYNTAX:

      VALUE
      <i>VARID</i>

      WHERE:

      VARID is hidden variable code'
  - name: SEED
    shortDesc: Displays the map seed
    fullDesc: 'Displays the map seed



      SYNTAX:

      SEED'
  - name: SHOWRIDS
    shortDesc: switches the RIDS display mode
    fullDesc: 'switches the RIDS display mode



      SYNTAX:

      SHOWRIDS'
  - name: FORCECLASS
    shortDesc: forces a class change
    fullDesc: 'forces a class change



      SYNTAX:

      FORCECLASS <i>CLASSID</i>

      WHERE:

      CLASSID
      is the identification number of the class



      NOTE:

      Check "CLASSLIST"
      to display a list of class IDs.'
  - name: GOTO
    shortDesc: move to the selected place
    fullDesc: 'move to the selected place



      SYNTAX:

      GOTO <i>ROOMID</i>

      WHERE:

      ROOMID
      is the identification number of the room



      NOTE:

      A full list
      of identification numbers is available mainly for testers.'
  - name: RANGE
    shortDesc: unlocks access to the shooting range
    fullDesc: 'unlocks access to the shooting range



      SYNTAX:

      RANGE'
  - name: ROUNDRESTART
    shortDesc: force round restart
    fullDesc: 'force round restart



      SYNTAX:

      ROUNDRESTART'
  - name: CONFIG
    shortDesc: configuration file commands
    fullDesc: 'Configuration file commands:



      SYNTAX:

      CONFIG <i>CMD</i>



      WHERE:

      CMD
      is one of the following arguments:



      -<b>RELOAD</b> or <b>RLD</b> or
      <b>R</b>

      Reloads the configuration file



      -<b>PATH</b>

      Displays
      the configuration file path



      -<b>VALUE <i>KEY</i></b>

      Displays
      <i>KEY</i> value'
  txt: {fileID: 4525}
  cmdField: {fileID: 4344}
  console: {fileID: 567}
